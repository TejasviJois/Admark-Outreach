# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
# Copy this file to .env.local and fill in real values.
# On Vercel: Project Settings → Environment Variables (do not put secrets in git).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Titan SMTP (preferred send path)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@admarkdigitals.com
SMTP_PASS=your-titan-mailbox-password
EMAIL_FROM=Admark <info@admarkdigitals.com>

# Optional alternate: Resend (used only if SMTP_* not set)
RESEND_API_KEY=

# AI personalization (future — stub only in V1)
GEMINI_API_KEY=
ENABLE_AI_PERSONALIZATION=false

# Cron + webhooks
CRON_SECRET=your-cron-secret
WEBHOOK_SECRET=your-webhook-secret
